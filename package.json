{
  "name": "@jawache/flow",
  "version": "0.0.1",
  "description": "Guardrails and breadcrumbs as code — packs you import, a config that typechecks, one adapter per harness.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jawache/work.git",
    "directory": "flow"
  },
  "keywords": [
    "claude",
    "claude-code",
    "guardrails",
    "hooks",
    "lint"
  ],
  "private": true,
  "type": "module",
  "bin": {
    "flow": "dist/flow.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist/flow.mjs",
    "dist/index.mjs",
    "dist/types/"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "//": "Commands live in the root justfile — run `just` (build-flow · typecheck-flow · test-flow · link-flow)."
  },
  "dependencies": {
    "@ast-grep/napi": "^0.42.3",
    "dependency-cruiser": "^18.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  }
}
